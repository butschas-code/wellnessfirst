---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import MarketingHero from '@/components/layout/MarketingHero.astro';
import HomePageFooter from '@/components/home/HomePageFooter.astro';
import { marketingPageLayout } from '@/lib/marketing-page';

const company = 'Wellness First Global Koncepts Private Limited';

const objectives = [
  {
    title: 'Healthcare and education',
    body: 'Health care, including preventive health care, sanitation and safe drinking water. Education, including special education, vocational skills and livelihood.',
  },
  {
    title: 'Abandoned senior citizens and persons with mental disabilities',
    body: 'Their welfare. For senior citizens, permitted work also includes old age homes, daycare centres and similar facilities.',
  },
  {
    title: 'Environmental sustainability',
    body: 'Protection of the environment, ecological balance, flora and fauna, and the quality of soil, air and water.',
  },
  {
    title: 'The welfare of society',
    body: 'A contribution to the welfare and development of society, through activities permitted under Schedule VII, within India.',
  },
] as const;

const areas = [
  'Hunger, healthcare, sanitation and safe drinking water',
  'Education, vocational skills and livelihood',
  'Gender equality, women, and facilities for senior citizens',
  'Environmental sustainability',
  'Heritage, art and culture',
  'Armed forces veterans and their dependents',
  'Sport, including Paralympic and Olympic sport',
  'National relief funds',
  'Research in science, technology, engineering and medicine',
  'Public universities, IITs and national research bodies',
  'Rural development',
  'Slum area development',
  'Disaster management, relief and reconstruction',
] as const;

const committee = [
  { name: 'Mr. Aviral Sethi', role: 'Director · Chairperson' },
  { name: 'Mr. Vinod Kumar', role: 'Director · Member' },
] as const;

const tints = ['wfg-card-home--tint', 'wfg-card-home--tint2', 'wfg-card-home--tint3', 'wfg-card-home--tint'] as const;
---

<BaseLayout
  title="Corporate Social Responsibility"
  description="Wellness First Global Koncepts Private Limited is committed to socially, economically and environmentally responsible business, and to the well-being of society."
  canonicalPath="/csr"
  {...marketingPageLayout}
>
  <MarketingHero
    compact
    eyebrow={company}
    title="Corporate Social Responsibility"
    description="A commitment to business that is socially, economically and environmentally responsible, and to the sustainable development and well-being of society."
  />

  <section class="wfg-home-band" aria-labelledby="h-commitment" data-bg="#f8faf8">
    <div class="container-wfg max-w-3xl py-16 md:py-20" data-reveal>
      <div class="wfg-reveal-child" style="--stagger: 0">
        <p class="wfg-home-kicker text-primary">The commitment</p>
        <h2 id="h-commitment" class="mt-2 font-display text-2xl font-medium text-ink sm:text-3xl md:text-4xl">
          Within India, and close to where the company works
        </h2>
        <div class="mt-6 max-w-prose-wfg space-y-4 text-sm leading-relaxed text-charcoal sm:text-base">
          <p>
            {company} conducts its business in a socially, economically and environmentally responsible manner, and
            contributes to the sustainable development and well-being of society.
          </p>
          <p>
            CSR is undertaken in India, in line with Schedule VII of the Companies Act, 2013. Preference goes to the
            local area and the areas around where the company operates.
          </p>
          <p>
            The policy is the framework for how activities are identified, chosen, carried out, monitored and reported.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="wfg-home-band" aria-labelledby="h-objectives" data-bg="#e8f0e9">
    <div class="container-wfg py-16 md:py-20" data-reveal>
      <div class="wfg-home-section-head wfg-reveal-child" style="--stagger: 0">
        <div>
          <p class="wfg-home-kicker text-primary">Objectives</p>
          <h2 id="h-objectives" class="mt-1 font-display text-2xl font-medium text-ink sm:text-3xl md:text-4xl">
            What the policy is for
          </h2>
        </div>
        <p class="text-sm leading-relaxed text-ink-500 sm:max-w-md sm:text-base">
          Four aims, set by the company. Anything further still has to sit inside Schedule VII, and needs the Board’s
          approval.
        </p>
      </div>
      <ul class="mt-10 grid list-none grid-cols-1 gap-5 sm:grid-cols-2 lg:gap-6" role="list">
        {
          objectives.map((item, i) => (
            <li>
              <article
                class:list={['flex h-full flex-col p-6 sm:p-7 wfg-reveal-child wfg-card-home', tints[i]]}
                style={`--stagger: ${i + 1}`}
              >
                <span
                  class:list={[
                    'wfg-home-number flex h-8 w-8 items-center justify-center rounded-full',
                    i % 3 === 0 ? 'bg-primary' : i % 3 === 1 ? 'bg-secondary' : 'bg-ink-600',
                  ]}
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-4 font-display text-xl font-medium text-ink sm:text-2xl">{item.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-charcoal sm:text-base">{item.body}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wfg-home-band" aria-labelledby="h-areas" data-bg="#f0f4f2">
    <div class="container-wfg py-16 md:py-20" data-reveal>
      <div class="wfg-reveal-child max-w-3xl" style="--stagger: 0">
        <p class="wfg-home-kicker text-primary">CSR activities</p>
        <h2 id="h-areas" class="mt-2 font-display text-2xl font-medium text-ink sm:text-3xl md:text-4xl">
          Areas the Board may approve
        </h2>
        <p class="mt-4 max-w-prose-wfg text-sm leading-relaxed text-charcoal sm:text-base">
          With the Board’s approval, CSR may fall in any of the areas below. They reflect Schedule VII. An activity is
          not CSR merely because it is named here — it has to be permitted under the Act and the CSR Rules. If Schedule
          VII later adds further activities, the company may take those up too.
        </p>
      </div>
      <ul class="mt-10 grid list-none grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {
          areas.map((area, i) => (
            <li
              class="wfg-reveal-child rounded-2xl border border-primary/10 bg-paper/80 px-5 py-4 text-sm leading-relaxed text-ink sm:text-base"
              style={`--stagger: ${i + 1}`}
            >
              {area}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wfg-home-band" aria-labelledby="h-oversight" data-bg="#d7e2da">
    <div class="container-wfg py-16 md:py-20" data-reveal>
      <div class="wfg-reveal-child max-w-3xl" style="--stagger: 0">
        <p class="wfg-home-kicker text-primary">Oversight</p>
        <h2 id="h-oversight" class="mt-2 font-display text-2xl font-medium text-ink sm:text-3xl md:text-4xl">
          Committee, spend and review
        </h2>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3 lg:gap-6">
        <article class="wfg-reveal-child wfg-card-home flex h-full flex-col p-6 sm:p-7" style="--stagger: 1">
          <p class="wfg-home-kicker text-secondary">Financial year 2021–22</p>
          <h3 class="mt-2 font-display text-xl font-medium text-ink sm:text-2xl">CSR Committee</h3>
          <ul class="mt-5 divide-y divide-primary/10" role="list">
            {
              committee.map((member) => (
                <li class="py-3 first:pt-0 last:pb-0">
                  <p class="font-medium text-ink">{member.name}</p>
                  <p class="mt-0.5 text-sm text-charcoal">{member.role}</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-sm leading-relaxed text-charcoal">
            The committee oversaw and monitored CSR under the Act, the CSR Rules and this policy. Where the law does not
            require a committee, the Board of Directors does that work.
          </p>
        </article>

        <article class="wfg-reveal-child wfg-card-home flex h-full flex-col p-6 sm:p-7" style="--stagger: 2">
          <p class="wfg-home-kicker text-secondary">Endeavours to spend</p>
          <h3 class="mt-2 font-display text-xl font-medium text-ink sm:text-2xl">Expenditure</h3>
          <p class="mt-5 font-display text-5xl font-medium tracking-tight text-primary">2%</p>
          <p class="mt-4 text-sm leading-relaxed text-charcoal sm:text-base">
            At least two per cent of average net profits over the three preceding financial years, or the amount the Act
            prescribes. Only on permitted activities. Surplus from CSR does not become business profit — it goes back
            into the project, is held for the policy, or is transferred to a Schedule VII fund.
          </p>
        </article>

        <article class="wfg-reveal-child wfg-card-home flex h-full flex-col p-6 sm:p-7" style="--stagger: 3">
          <p class="wfg-home-kicker text-secondary">The Board</p>
          <h3 class="mt-2 font-display text-xl font-medium text-ink sm:text-2xl">Review</h3>
          <p class="mt-5 text-sm leading-relaxed text-charcoal sm:text-base">
            The Board monitors the work and satisfies itself that funds are used as it approved. It reviews the policy
            so it stays aligned with the Act, the Rules and Schedule VII, and may revise it.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-charcoal sm:text-base">
            The committee, this policy and the projects the Board approves are disclosed on
            <a class="link-wfg" href="https://www.wellnessfirstglobal.com">wellnessfirstglobal.com</a>. If the policy and
            the law conflict, the law prevails.
          </p>
        </article>
      </div>

      <p class="wfg-reveal-child mt-8 max-w-3xl text-sm leading-relaxed text-charcoal sm:text-base" style="--stagger: 4">
        The company may carry out the work itself, or through an eligible implementing agency. It may also collaborate
        with other companies, as long as each can report on the work separately.
      </p>
    </div>
  </section>

  <HomePageFooter slot="footer" />
</BaseLayout>
